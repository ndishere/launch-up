# ==============================================================================
# LAUNCH UP — PRODUCTION ENVIRONMENT & MICROSERVICE MESH CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend & Gemini AI Runtime
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
APP_URL="http://localhost:3000"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY="sk-your-openai-key"
LITELLM_BASE_URL="http://localhost:4000/v1"
LITELLM_API_KEY="sk-litellm-master-key"

# ------------------------------------------------------------------------------
# Microservice Mesh Port Bindings (MOD-01 through MOD-10)
# ------------------------------------------------------------------------------
MOD10_PORT=8004   # Governance, M:N Tenancy, RBAC & FinOps Core
MOD01_PORT=8005   # Lead Discovery & Canva Pitch Engine
MOD02_PORT=8006   # BA Intake & Legal Compliance Synthesizer
MOD03_PORT=8007   # Responsive Web & Landing Builder
MOD04_PORT=8008   # Android Mobile App Builder
MOD05_PORT=8009   # Backend API & PostgreSQL RLS Engine
MOD06_PORT=8010   # Autonomous QA, SecOps & Lighthouse Verifier
MOD07_PORT=8011   # Canva Pro Digital Marketing Engine
MOD08_PORT=8012   # WhatsApp Marketing & CRM RAG Engine
MOD09_PORT=8013   # Autonomous SRE & Self-Healing Operations

# ------------------------------------------------------------------------------
# Core Governance Database (PostgreSQL 16 + RLS + Redis)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/launchup"
REDIS_URL="redis://127.0.0.1:6379"
JWT_SECRET="replace-with-secure-random-jwt-secret-at-least-32-chars"
RLS_ENFORCE=true

# ------------------------------------------------------------------------------
# External Agency Integrations (Canva Pro, Meta WhatsApp, Sentry, GitHub)
# ------------------------------------------------------------------------------
CANVA_CLIENT_ID="canva-oauth-client-id"
CANVA_CLIENT_SECRET="canva-oauth-client-secret"

WHATSAPP_CLOUD_API_TOKEN="EAAG_meta_whatsapp_token"
WHATSAPP_PHONE_NUMBER_ID="109283746501928"
WHATSAPP_VERIFY_TOKEN="launchup_whatsapp_webhook_verify"

SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_WEBHOOK_SECRET="launchup-sentry-hmac-secret"

GITHUB_PAT="ghp_your_github_token_for_hotfix_prs"
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON="{}"
