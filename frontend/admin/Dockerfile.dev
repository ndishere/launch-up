FROM node:22-alpine AS dev

WORKDIR /app

COPY package.json pnpm-lock.yaml* bun.lock* ./
RUN corepack enable && corepack prepare pnpm@latest --activate && pnpm install 2>/dev/null || npm install

COPY vite.config.ts tsconfig.json index.html ./
COPY src/ ./src/
COPY public/ ./public/

EXPOSE 3000
CMD ["npx", "vite", "--port=3000", "--host=0.0.0.0"]

