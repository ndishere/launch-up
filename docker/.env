# =====================================================
# Launch Up — Docker Environment Variables
# =====================================================

# ─── PostgreSQL ───
POSTGRES_USER=launchup
POSTGRES_PASSWORD=launchup_dev_2024
POSTGRES_DB=launchup
POSTGRES_PORT=5432

# ─── Redis ───
REDIS_PASSWORD=redis_dev_2024
REDIS_PORT=6379

# ─── Kong API Gateway ───
KONG_DATABASE=off
KONG_PROXY_LISTEN=0.0.0.0:8000
KONG_ADMIN_LISTEN=0.0.0.0:8001

# ─── Auth Service ───
AUTH_SERVICE_PORT=8001
JWT_SECRET=launchup-dev-jwt-secret-change-in-production-2024
JWT_REFRESH_SECRET=launchup-dev-refresh-secret-change-in-production-2024
BCRYPT_ROUNDS=12
SUPER_ADMIN_EMAIL=admin@launchup.io
SUPER_ADMIN_PASSWORD=LaunchUp@Admin2024

# ─── Client Service ───
CLIENT_SERVICE_PORT=8002

# ─── Project Service ───
PROJECT_SERVICE_PORT=8003

# ─── Deployment Service ───
DEPLOYMENT_SERVICE_PORT=8004

# ─── Billing Service ───
BILLING_SERVICE_PORT=8005
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ─── Shared Database URL ───
DATABASE_URL=postgresql://launchup:launchup_dev_2024@postgres:5432/launchup

# ─── Kafka ───
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ─── MinIO (S3-compatible) ───
MINIO_ROOT_USER=launchup_minio
MINIO_ROOT_PASSWORD=minio_dev_2024
MINIO_ENDPOINT=http://minio:9000

# ─── Elasticsearch ───
ELASTICSEARCH_URL=http://elasticsearch:9200

# ─── Environment ───
NODE_ENV=development
LOG_LEVEL=debug

