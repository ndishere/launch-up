  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "pino-pretty": "^13.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
